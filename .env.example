# Copy to .env.local and fill in. .env.local is git-ignored.
#
# Cloud name is shown at the top of the Cloudinary console dashboard, and is the
# <cloud_name> segment in every delivery URL: res.cloudinary.com/<cloud_name>/...
CLOUDINARY_CLOUD_NAME=
# Same value, exposed to the browser so the next/image loader can build
# delivery URLs. Cloud names are public — they appear in every image URL.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Settings -> Access Keys in the Cloudinary console.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Staff portal (/admin) --------------------------------------------------
# Signs sessions and encrypts tokens stored in the portal. 32+ random chars:
#   openssl rand -hex 32
# Keep it stable: changing it signs everyone out and makes stored secrets unreadable.
SESSION_SECRET=
# First-run only: becomes the first staff account when none exists yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Where the SQLite database lives. Must be a persistent volume in production.
DATA_DIR=./data
# Used for OAuth redirect URIs and links in emails.
SITE_URL=https://newlight-academy.rw

# Everything below can also be entered in the portal (Settings → Integrations);
# a value saved there overrides the one here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
META_APP_ID=
META_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_USER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
